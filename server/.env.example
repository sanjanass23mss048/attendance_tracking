# Point at the Attendence Postgres database (existing DBeaver tables).
# Example (replace USER/PASSWORD/HOST — do not commit real secrets):
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/Attendence"

# Tenant registry (Attendence_Tenants) — user must be able to CREATE DATABASE.
# Do not point this at Bright Future Attendence or ALM's tenant registry.
TENANT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/Attendence_Tenants"

# Apex + school subdomains: {slug}.rioassetmanagement.info
MAIN_DOMAIN=rioassetmanagement.info

# Optional: required to create schools at /setup (query ?secret= or form field)
SETUP_SECRET=

# Required: long random string for JWT signing
JWT_SECRET="change-me-to-a-long-random-string"

# Gmail (App Password) for forgot-password emails — never commit real secrets
# From address, e.g. bizsolsrio@gmail.com
EMAIL_USER=
EMAIL_PASS=
# Optional: force reset links onto this public origin (defaults to https://MAIN_DOMAIN)
# APP_PUBLIC_URL=https://rioassetmanagement.info

# HTTP port (one process serves UI + API in production)
PORT=4000

# Use development locally. Docker Compose / VPS sets production.
NODE_ENV=development

# Public browser origin(s), comma-separated.
# Same-origin deploy (UI served by this server): http://YOUR_VPS_IP:4000
# Behind nginx on 80/443: https://rioassetmanagement.info
CLIENT_ORIGIN="https://rioassetmanagement.info"

# Uploaded documents (PDF, images) — created automatically if missing
UPLOAD_DIR=
UPLOAD_MAX_BYTES=10485760

# School timezone for same-day vs previous-day attendance lock
# These (and SMS / WhatsApp / FCM keys below) are copied into tblApp_Settings on first boot.
# After that, edit them in the app under Settings — the API reads the database, not this file.
SCHOOL_TIMEZONE=Asia/Kolkata
EDIT_PERMISSION_MINUTES=30

# Parent notice push (Firebase Cloud Messaging)
# Required on production for background push from teacher Send Notification.
# Copy firebase-service-account.json next to this file (gitignored) and mount via docker-compose.prod.yml.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FCM_SERVER_KEY=

# Meta WhatsApp Cloud API (server-only — never expose to React)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Set to true only for local dev when webhook signature fails (use correct App Secret in production)
WHATSAPP_WEBHOOK_SKIP_VERIFY=
META_GRAPH_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=attendance_approval
WHATSAPP_TEMPLATE_LANG=en

# Parent attendance SMS (server-only — never put these in the APK)
# SMS_PROVIDER=console | twilio | msg91
SMS_PROVIDER=msg91
SMS_DEFAULT_COUNTRY=91

# Twilio (optional)
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=

# MSG91 (India) — required when SMS_PROVIDER=msg91
SMS_MSG91_AUTH_KEY=
SMS_MSG91_SENDER_ID=
SMS_MSG91_TEMPLATE_ID=
SMS_MSG91_ROUTE=4
