# Point at the Attendence Postgres database (existing DBeaver tables).
# Example (replace USER/PASSWORD/HOST — do not commit real secrets):
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/Attendence"

# Required: long random string for JWT signing
JWT_SECRET="change-me-to-a-long-random-string"

# HTTP port (one process serves UI + API in production)
PORT=4000

# Use development locally. Docker Compose / VPS sets production.
NODE_ENV=development

# Public browser origin(s), comma-separated.
# Same-origin deploy (UI served by this server): http://YOUR_VPS_IP:4000
# Behind nginx on 80/443: https://attendance.example.com
CLIENT_ORIGIN="http://103.192.199.178:4000"

# Uploaded documents (PDF, images) — created automatically if missing
UPLOAD_DIR=
UPLOAD_MAX_BYTES=10485760

# School timezone for same-day vs previous-day attendance lock
SCHOOL_TIMEZONE=Asia/Kolkata
EDIT_PERMISSION_MINUTES=30

# Meta WhatsApp Cloud API (server-only — never expose to React)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Set to true only for local dev when webhook signature fails (use correct App Secret in production)
WHATSAPP_WEBHOOK_SKIP_VERIFY=
META_GRAPH_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=attendance_approval
WHATSAPP_TEMPLATE_LANG=en
