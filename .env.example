# Frontend (Vite)
# Live API (default): VITE_USE_MOCK=false or omit
# Local mock UI only: VITE_USE_MOCK=true
VITE_USE_MOCK=false

# API URL for the browser:
# - Local (direct to API): http://localhost:4000
# - Local (Vite proxy) or production build: leave empty (same-origin /api)
VITE_API_URL=http://localhost:4000

# Existing calendar / holidays (optional)
VITE_HOLIDAY_COUNTRY=IN
VITE_HOLIDAY_STATE=TN
VITE_CALENDARIFIC_API_KEY=
