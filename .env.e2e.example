# Playwright E2E against local production build (default).
# 1) Start Postgres (docker compose up -d postgres)
# 2) Configure server/.env (DATABASE_URL, JWT_SECRET)
# 3) npm run build && npm run prisma:migrate --prefix server && npm run prisma:seed --prefix server
# 4) npm run test:e2e
#
# Defaults match server/prisma/seed.js (Bright Future demo login).

E2E_BASE_URL=http://127.0.0.1:4000/
E2E_EMAIL=incharge@brightfuture.edu.in
E2E_PASSWORD=password123
